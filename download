   "blocks": [
    {
     "t": "p",
     "x": "O Imposto sobre os Veículos Motorizados incide sobre os veículos motorizados, matriculados ou registados, de acordo com a legislação aplicável, junto dos respectivos serviços públicos competentes, designadamente:"
    },
    {
