   "epigraph": "Critérios para a determinação da matéria colectável",
   "path": [
    "CAPÍTULO III - MATÉRIA COLECTÁVEL E TAXAS"
   ],
   "blocks": [
    {
     "t": "p",
     "x": "1. O valor do imposto a pagar é determinado tendo em consideração:"
    },
